{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/blog/category/:slug", "destination": "/category.html" },
    { "source": "/blog/:slug", "destination": "/article.html" },
    { "source": "/blog", "destination": "/insights.html" },
    { "source": "/insights/:slug", "destination": "/article.html" }
  ]
}
