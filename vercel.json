{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/blog/category/:category",
      "destination": "/insights.html?category=:category"
    },
    {
      "source": "/blog/:slug",
      "destination": "/article.html?slug=:slug"
    },
    {
      "source": "/blog",
      "destination": "/insights.html"
    },
    {
      "source": "/insights/:slug",
      "destination": "/article.html"
    },
    {
      "source": "/blog-sitemap.xml",
      "destination": "/api/blog-sitemap"
    }
  ]
}
